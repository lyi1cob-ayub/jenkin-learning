# Application
APP_NAME=Bosch AI RCA Agent

# Database
DATABASE_URL=mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Ollama
OLLAMA_HOST=http://<OLLAMA_HOST>:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TEMPERATURE=0.2

# OpenRouter
USE_OPENROUTER=False
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Agent Settings
PROMPT_FILE_PATH=app/prompts/prompts.yaml
MAX_LOG_LINES=100
ACTIVE_PROMPT_VERSION=v4

# Jenkins Integration
JENKINS_URL=http://<JENKINS_HOST>:<JENKINS_PORT>
JENKINS_USER=<JENKINS_USER>
JENKINS_TOKEN=<JENKINS_API_TOKEN>

# Microsoft Teams / Power Automate
TEAMS_WEBHOOK_URL=<TEAMS_WEBHOOK_URL>

# Log Parser
LOG_PARSER_MAX_CONTEXT_LINES=40
LOG_PARSER_MAX_TOTAL_CHARS=24000
LOG_PARSER_MAX_LINE_LENGTH=2000

LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=http://10.244.9.208:3001