        // }
        stage('Simulate Infrastructure Failure') {
            steps {
                sh '''
                    echo "=== Simulating Infrastructure Failure ==="
                    echo "Checking system dependencies..."
                    
                    # Attempting to call an uninstalled CLI tool to simulate a missing binary/dependency
                    if ! command -v non_existent_cli_tool &> /dev/null; then
                        echo "FATAL: Required binary 'non_existent_cli_tool' is missing or not executable on worker node."
                        echo "ERROR: Infrastructure dependency check failed."
                        exit 127
                    fi

                    non_existent_cli_tool --version
                '''
            }
        }
    }
    post {
        failure {
            script {

                // def logUrl = "${BUILD_URL}consoleText"

                // def payload = """{
                //     "build_id": "${BUILD_NUMBER}",
                //     "job_name": "${JOB_NAME}",
                //     "log_url": "${logUrl}",
                //     "git_author_email": "fixed-term.Ayub.Alikhan@in.bosch.com"
                // }"""

                // echo "Triggering RCA Agent..."

                // sh """
                //     curl -X POST \
                //     'https://obscure-space-memory-gx5q9p6r764v39wrr-8000.app.github.dev/api/v1/analyse' \
                //     -H 'Content-Type: application/json' \
                //     -d '${payload}'
                // """
                def internalLogUrl = "http://172.17.0.1:8081/job/${JOB_NAME}/${BUILD_NUMBER}/consoleText"

                def payload = """{
                    "build_id": "${BUILD_NUMBER}",
                    "job_name": "${JOB_NAME}",
                    "log_url": "${internalLogUrl}",
                    "git_author_email": "fixed-term.Ayub.Alikhan@in.bosch.com"
                }"""

                echo "Triggering FastAPI RCA webhook for build ${BUILD_NUMBER}..."
                sh """
                    curl -X POST "http://10.244.9.208:8000/api/v1/analyse" \\
                        -H "Content-Type: application/json" \\
                        -d '${payload}'
                """
            }
        }
    }
}