pipeline {
    agent any

    stages {

        stage('Network Diagnostics') {
            steps {
                sh '''
                    echo "======================================"
                    echo "NETWORK DIAGNOSTICS"
                    echo "======================================"

                    echo
                    echo "=== DNS Test ==="
                    nslookup github.com || true

                    echo
                    echo "=== Internet Connectivity ==="
                    curl -I https://google.com || true

                    echo
                    echo "=== GitHub Connectivity ==="
                    curl -I https://github.com || true

                    echo
                    echo "=== RCA Agent Connectivity ==="
                    curl -I https://obscure-space-memory-gx5q9p6r764v39wrr-8000.app.github.dev || true

                    echo
                    echo "=== Detailed RCA Agent Request ==="
                    curl -v https://obscure-space-memory-gx5q9p6r764v39wrr-8000.app.github.dev || true

                    echo
                    echo "=== Route Information ==="
                    ip route || true

                    echo
                    echo "=== Host Information ==="
                    hostname || true

                    echo
                    echo "=== Force Failure for RCA Testing ==="
                    exit 1
                '''
            }
        }
    }

    post {
        failure {
            script {

                def logUrl = "${BUILD_URL}consoleText"

                def payload = """{
                    "build_id": "${BUILD_NUMBER}",
                    "job_name": "${JOB_NAME}",
                    "log_url": "${logUrl}",
                    "git_author_email": "test_dev@example.com"
                }"""

                echo "Triggering RCA Agent..."

                sh """
                    curl -X POST \
                    'https://obscure-space-memory-gx5q9p6r764v39wrr-8000.app.github.dev/api/v1/analyse' \
                    -H 'Content-Type: application/json' \
                    -d '${payload}'
                """
            }
        }
    }
}