pipeline{
    agent any
    stages{
        stage('simuate the build failure'){
            steps{
                echo 'Running the model...'
                sh 'exit 1'
            }
        }
    }
    post{
        failure{
            script{
               def internalLogUrl = "http://172.17.0.1:8081/job/${JOB_NAME}/${BUILD_NUMBER}/consoleText"

                def payload = """{
                    "build_id": "${BUILD_NUMBER}",
                    "job_name": "${JOB_NAME}",
                    "log_url": "${internalLogUrl}",
                    "git_author_email": "test_dev@example.com"
                }"""

                sh """
                    curl -X POST "http://172.17.0.1:8000/api/v1/analyse" \\
                         -H "Content-Type: application/json" \\
                         -d '${payload}'
                """
            }
        }
    }
}